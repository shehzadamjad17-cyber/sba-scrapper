# Database (same Turso DB as the website)
DATABASE_URL="libsql://your-db-name.turso.io"
DATABASE_AUTH_TOKEN="<turso-token>"

# Gemini (CSV of API keys for round-robin)
# Run production with AT LEAST 2 keys: a single free-tier key (10 RPM) can
# stall the 3-parallel article-generation burst behind the rate limiter.
GEMINI_API_KEYS="key1,key2,key3"

# Reddit OAuth (OPTIONAL — script-type app from https://www.reddit.com/prefs/apps)
# If any of these 3 are unset, the Reddit adapter is skipped at runtime
# and the scraper runs with Google PAA + YouTube only. To enable Reddit
# later, set all 3 and redeploy — no code change needed.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT=""

# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY="..."

# Cron auth — random string; Vercel injects this header on cron calls
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Resend (failure-alert emails)
RESEND_API_KEY="re_..."
SCRAPER_ALERT_EMAIL="admin@sbaloanoptions.com"

# --- Lead-engine rewire (2026-07) ---
# Admin User.id on the main site — author for scraper-created BlogPost drafts
SCRAPER_AUTHOR_ID=""
# Main site origin, used for digest email links (no trailing slash)
SITE_PUBLIC_URL="https://www.sbaloanoptions.com"
# Fallback cover image (UploadThing URL) when a niche imagePool is empty
DEFAULT_COVER_IMAGE=""
