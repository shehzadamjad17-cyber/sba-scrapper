generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model BlogDraft {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  sourceType        String
  sourceUrl         String
  sourceQuestion    String
  niche             String
  title             String
  titleVariants     String
  clearAnswer       String
  bodyOutline       String
  comparisonTable   String
  faqSection        String
  internalLinks     String
  ctaBlock          String
  imagePrompt       String
  intentScore       Float
  nicheMatch        Float
  totalScore        Float
  status            String    @default("pending")
  promotedToPostId  String?   @unique
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectedReason    String?
  promotedAt        DateTime?
  reviewerId        String?
  llmModel          String
  llmPromptVersion  String
  llmResponseRaw    String

  @@index([status, createdAt])
  @@index([niche, status])
}

model ScraperRun {
  id                    String    @id @default(cuid())
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  status                String
  errorMessage          String?
  niche                 String
  itemsFetched          Int       @default(0)
  candidatesAfterDedup  Int       @default(0)
  draftId               String?   @unique
  topScore              Float?
  adapterStats          String

  @@index([startedAt])
  @@index([status])
}

model BlogPost {
  // Mirror of the website's BlogPost table (same Turso DB). The scraper
  // writes drafts here directly (see src/pipeline/persist.ts) in addition to
  // reading titles for dedup and link-menu suggestions — field set must stay
  // in sync with the website's prisma/schema.prisma BlogPost model.
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  coverImage   String
  body         String
  status       String    @default("draft")
  publishedAt  DateTime?
  authorId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}
